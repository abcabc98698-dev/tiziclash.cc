---
import { ui } from '../data/site'
import Base from '../layouts/Base.astro'

// Static hosts serve dist/404.html for any unmatched path.
---

<Base title={ui.notFound.title} description={ui.notFound.description} noindex={true}>
  <div class="container not-found">
    <span class="mono-label is-accent">404</span>
    <h1 class="t-h1">{ui.notFound.title}</h1>
    <p class="prose">{ui.notFound.description}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/">{ui.notFound.home}</a>
      <a class="btn" href="/rankings/">
        {ui.notFound.blog}
        <span class="arrow" aria-hidden="true">
          →
        </span>
      </a>
    </div>
  </div>
</Base>
