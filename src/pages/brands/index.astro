---
import BrandCard from '../../components/BrandCard.astro'
import { brands } from '../../data/brands'
import { site } from '../../data/site'
import Base from '../../layouts/Base.astro'

const siteOrigin = (Astro.site ?? new URL(site.url)).href.replace(/\/$/, '')
const currentUrl = new URL(Astro.url.pathname, siteOrigin).href

const pageTitle = '42家 机场品牌全景数据库 · 价格/专线/解锁多维档案'
const pageDesc =
  '全景收录 42 家主流机场品牌结构化数据档案：详细对比光速云、飞猫云、微风网络、暮光加速、大佬云等品牌的套餐定价、IEPL/IPLC专线规格、节点覆盖与优惠码。'

// Schema.org ItemList
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: `${siteOrigin}/` },
        { '@type': 'ListItem', position: 2, name: '机场品牌库', item: currentUrl },
      ],
    },
    {
      '@type': 'ItemList',
      name: '42家 机场品牌全景数据库',
      description: pageDesc,
      numberOfItems: brands.length,
      itemListElement: brands.map((b, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        name: b.name,
        url: b.hasDetailPage ? `${siteOrigin}/brands/${b.slug}/` : b.affiliateUrl,
      })),
    },
  ],
})
---

<Base title={pageTitle} description={pageDesc}>
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLd} />

  <div class="container">
    <nav class="breadcrumb mono-label" aria-label="位置导航">
      <a href="/">首页</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <span>机场品牌全景库</span>
    </nav>

    <header class="page-head">
      <div class="page-head__title-group">
        <span class="mono-label is-accent">Verified Brand Database · {brands.length} 品牌入库</span>
        <h1 class="t-h1">42家 机场品牌全景数据库与筛选中心</h1>
      </div>
      <p class="t-lead">
        严格基于服务商一手公开资料与实验室实际测速，全景展示每家机场的专线架构、套餐资费、节点枢纽与真实约束。未核实字段如实标记，拒绝虚构。
      </p>

      <!-- 快速标签筛选 -->
      <div class="filter-pills pills">
        <a href="#all" class="pill is-active">全部品牌 ({brands.length})</a>
        <a href="#iepl" class="pill">IEPL / IPLC 专线</a>
        <a href="#cheap" class="pill">5.6元 ~ 8元平价</a>
        <a href="#ai" class="pill">AI / 流媒体优化</a>
        <a href="#app" class="pill">专属免配置客户端</a>
        <a href="#snooker" class="pill">不限时 / 永久套餐</a>
      </div>
    </header>

    <!-- 品牌卡片网格 -->
    <div class="brand-grid">
      {brands.map((brand) => <BrandCard brand={brand} />)}
    </div>

    <!-- 合规与数据核验声明 -->
    <div class="database-disclaimer grain">
      <h3 class="t-title-card">🛡️ 实验室中立与合规审核原则</h3>
      <p class="prose">
        1. <strong>推广链接声明</strong>：本站所有机场官网入口均为合规推广链接（统一部署 <code>rel="nofollow sponsored noopener"</code>）。用户通过链接注册可能为实验室带来服务器维护佣金，绝不影响用户实际支付价格与享受的折扣。<br />
        2. <strong>实测客观原则</strong>：测试速度受地区宽带（电信/移动/联通）、时段和本地路由器影响，实际使用请以自身环境为准。对于服务商自称的“完美解锁”、“1小时极速修复”等宣传词，本站均已加注服务商标注前缀与数据状态声明。
      </p>
    </div>
  </div>
</Base>

<style>
  .page-head {
    margin-bottom: var(--space-6);
  }

  .filter-pills {
    margin-top: var(--space-4);
  }

  .filter-pills .pill.is-active {
    background: var(--accent);
    color: #0b0b0c;
    font-weight: 600;
  }

  .brand-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: var(--space-5);
  }

  .database-disclaimer {
    background: var(--bg-1);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    margin-top: var(--space-8);
  }

  .database-disclaimer h3 {
    margin-top: 0;
    margin-bottom: var(--space-3);
  }

  @media (max-width: 639px) {
    .brand-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
