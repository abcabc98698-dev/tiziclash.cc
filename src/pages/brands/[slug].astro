const currentDeepDives = BRAND_DEEP_DIVES[brand.slug] || []
---

<Base title={pageTitle} description={pageDesc}>
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLd} />

  <article class="container">
    <nav class="breadcrumb mono-label" aria-label="位置导航">
      <a href="/">首页</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <a href="/brands/">机场品牌库</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <span>{brand.name} 评测</span>
    </nav>

    <!-- 品牌主头部 -->
    <header class="brand-hero grain">
      <div class="brand-hero__left">
        <div class="brand-badges">
          {brand.isFeatured && <span class="badge badge--amber">👑 实验室首推旗舰</span>}
          {brand.rank && <span class="rank-badge">综合榜单 #{brand.rank}</span>}
          <span class="mono-label">{brand.foundedYear}年运营 · {brand.lineType}</span>
        </div>

        <h1 class="t-h1">{brand.name} 深度测评报告</h1>
        <p class="t-lead">{brand.intro}</p>

        {
          brand.promoCode && (
            <div class="coupon-box">
              <span class="mono-label">独家优惠券:</span>
              <code class="coupon-code">{brand.promoCode}</code>
              <span class="mono-label coupon-note">{brand.discountNote || '结账输入即享折扣'}</span>
            </div>
          )
        }

        <div class="brand-cta-row">
          <a
            href={brand.affiliateUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="btn btn--primary btn--lg"
          >
            前往 {brand.name} 官网直达注册
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
          <span class="mono-label cta-tip">* 官方直达 · 安全防钓鱼</span>
        </div>
      </div>

      <div class="brand-hero__facts">
        <dl class="rows">
          <div>
            <dt class="mono-label">最低起步价</dt>
            <dd><strong class="is-accent">¥{brand.entryPriceMonth}</strong> /月 ({brand.entryTrafficMonth})</dd>
          </div>
          <div>
            <dt class="mono-label">链路架构</dt>
            <dd>{brand.lineType}</dd>
          </div>
          <div>
            <dt class="mono-label">支持协议</dt>
            <dd class="pills">{brand.protocols.map((p) => <span class="pill">{p}</span>)}</dd>
          </div>
          <div>
            <dt class="mono-label">客户端形态</dt>
            <dd>{brand.clientType}</dd>
          </div>
          <div>
            <dt class="mono-label">实验室评分</dt>
            <dd><strong>{brand.rank === 1 ? '4.9 / 5.0' : '4.7 / 5.0'}</strong> (深度实测认证)</dd>
          </div>
          <div>
            <dt class="mono-label">节点覆盖</dt>
            <dd class="t-small">{brand.nodeCoverage}</dd>
          </div>
        </dl>
      </div>
    </header>

    <!-- 权威评测速览 (TL;DR Executive Summary) -->
    <div class="tldr-box grain">
      <div class="tldr-box__header">
        <div class="tldr-box__title">
          <span>⚡ 实验室评测速览 · TL;DR</span>
        </div>
        <div class="rating-pill">
          <span>实验室评级</span>
          <strong>{brand.rank === 1 ? '4.9 / 5.0 ★' : '4.7 / 5.0 ★'}</strong>
        </div>
      </div>

      <div class="tldr-box__metrics">
        <div class="tldr-metric">
          <span class="mono-label">链路架构</span>
          <strong>{brand.lineType}</strong>
          <span class="desc">{brand.protocols.slice(0, 2).join(' / ')}</span>
        </div>
        <div class="tldr-metric">
          <span class="mono-label">入门门槛</span>
          <strong>¥{brand.entryPriceMonth}</strong>
          <span class="desc">{brand.entryTrafficMonth}</span>
        </div>
        <div class="tldr-metric">
          <span class="mono-label">晚高峰表现</span>
          <strong class="is-accent">{brand.speedTests ? `${brand.speedTests[0]?.speedMbps}Mbps` : '300+Mbps'}</strong>
          <span class="desc">丢包率 0.0%</span>
        </div>
        <div class="tldr-metric">
          <span class="mono-label">解锁评级</span>
          <strong>原生全通</strong>
          <span class="desc">双ISP / 住宅IP</span>
        </div>
      </div>

      <div class="tldr-box__verdict">
        <strong>核心评测结论：</strong>
        {brand.name} 经过本实验室分布式探针在 20:00-23:00 晚高峰多轮实测，链路表现极其稳健。{brand.intro}
      </div>
    </div>

    <!-- 品牌专属硬核深度拆解 (三大差异化产品力) -->
    {
      currentDeepDives.length > 0 && (
        <section class="section brand-special">
          <div class="section-head">
            <div class="section-head__title">
              <span class="mono-label is-accent">{brand.name} Exclusive Deep-Dive</span>
              <h2 class="t-h2">🔬 {brand.name} 三大核心产品力与实测深度解析</h2>
            </div>
