---
import type { GetStaticPaths } from 'astro'
import NetworkTopology from '../../components/NetworkTopology.astro'
import ObservatoryDashboard from '../../components/ObservatoryDashboard.astro'
import UnlockMatrix from '../../components/UnlockMatrix.astro'
import { brands } from '../../data/brands'
import { site } from '../../data/site'
import type { Brand } from '../../data/types'
import Base from '../../layouts/Base.astro'

export const getStaticPaths = (() => {
  // 仅为配置有独立详情页的品牌生成路由（Top 10 + 光速云专题 + 梯子云）
  return brands
    .filter((b) => b.hasDetailPage)
    .map((brand, index, arr) => ({
      params: { slug: brand.slug },
      props: {
        brand,
        prev: arr[index - 1],
        next: arr[index + 1],
      },
    }))
}) satisfies GetStaticPaths

interface Props {
  brand: Brand
  prev?: Brand
  next?: Brand
}

const { brand, prev, next } = Astro.props

const siteOrigin = (Astro.site ?? new URL(site.url)).href.replace(/\/$/, '')
const currentUrl = new URL(Astro.url.pathname, siteOrigin).href

const pageTitle = `${brand.name}怎么样？2026最新评测 · 优惠码 · 晚高峰测速与套餐解析`
const pageDesc = `${brand.name} 2026年实测报告：采用${brand.lineType}，协议支持${brand.protocols.join('/')}，起步价¥${brand.entryPriceMonth}/月起。深度解析其晚高峰丢包率、ChatGPT流媒体解锁能力、套餐价格表与最新优惠码。`

// Schema.org Product / Review / BreadcrumbList
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: `${siteOrigin}/` },
        { '@type': 'ListItem', position: 2, name: '机场品牌库', item: `${siteOrigin}/brands/` },
        { '@type': 'ListItem', position: 3, name: brand.name, item: currentUrl },
      ],
    },
    {
      '@type': 'Product',
      name: `${brand.name} 专线机场服务`,
      description: brand.intro,
      brand: { '@type': 'Brand', name: brand.name },
      offers: {
        '@type': 'AggregateOffer',
        priceCurrency: 'CNY',
        lowPrice: brand.entryPriceMonth,
        offerCount: brand.pricing.length,
      },
      review: {
        '@type': 'Review',
        reviewRating: {
          '@type': 'Rating',
          ratingValue: brand.rank === 1 ? '4.9' : '4.7',
          bestRating: '5',
        },
        author: { '@type': 'Organization', name: site.name },
        reviewBody: brand.intro,
      },
    },
  ],
})

interface DistinctFeature {
  icon: string
  title: string
  desc: string
}

const BRAND_DEEP_DIVES: Record<string, DistinctFeature[]> = {
