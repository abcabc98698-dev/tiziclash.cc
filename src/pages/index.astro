---
import About from '../components/About.astro'
import Contact from '../components/Contact.astro'
import DecisionTree from '../components/DecisionTree.astro'
import GuangsuSpotlight from '../components/GuangsuSpotlight.astro'
import Hero from '../components/Hero.astro'
import NetworkTopology from '../components/NetworkTopology.astro'
import ObservatoryDashboard from '../components/ObservatoryDashboard.astro'
import TopRanking from '../components/TopRanking.astro'
import UnlockMatrix from '../components/UnlockMatrix.astro'
import { site } from '../data/site'
import Base from '../layouts/Base.astro'

const siteOrigin = (Astro.site ?? new URL(site.url)).href.replace(/\/$/, '')
const currentUrl = new URL(Astro.url.pathname, siteOrigin).href

// Rich Schema.org Structured Data
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}/#website`,
      url: `${siteOrigin}/`,
      name: site.name,
      description: site.description,
      inLanguage: site.lang,
      publisher: {
        '@id': `${siteOrigin}/#organization`,
      },
    },
    {
      '@type': 'Organization',
      '@id': `${siteOrigin}/#organization`,
      name: site.name,
      url: `${siteOrigin}/`,
      logo: `${siteOrigin}/avatar.webp`,
      sameAs: Object.values(site.links).filter(Boolean),
      contactPoint: {
        '@type': 'ContactPoint',
        email: site.email,
        contactType: 'technical support',
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${currentUrl}#webpage`,
      url: currentUrl,
      name: site.title,
      description: site.description,
      inLanguage: site.lang,
      isPartOf: {
        '@id': `${siteOrigin}/#website`,
      },
    },
  ],
})
---

<Base>
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLd} />
  <div class="container">
    <Hero />
    <GuangsuSpotlight />
    <DecisionTree />
    <TopRanking />
    
    <section class="section" id="observatory">
      <div class="section-head">
        <div class="section-head__title">
          <span class="mono-label is-accent">Network Observatory</span>
          <h2 class="t-h2">📊 晚高峰链路可观测性大盘</h2>
        </div>
        <span class="mono-label">拒绝口头承诺 · 呈现真实数据</span>
      </div>
      <ObservatoryDashboard />
      <UnlockMatrix />
      <NetworkTopology />
    </section>

    <About />
    <Contact />
  </div>
</Base>
