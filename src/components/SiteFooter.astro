---
import { footer, site, ui } from '../data/site'

const year = new Date().getFullYear()

// Only the links that are set in site.links are shown.
const LINK_LABELS: Record<string, string> = {
  github: 'GitHub',
  telegram: 'Telegram',
  rss: 'RSS',
}
const links = (Object.keys(site.links) as (keyof typeof site.links)[])
  .filter((key) => site.links[key])
  .map((key) => ({ label: LINK_LABELS[key] ?? key, href: site.links[key] as string }))

const pillars = [
  { label: 'VPN对比', href: '/vpn/' },
  { label: '机场推荐', href: '/jichang/' },
  { label: 'Clash专题', href: '/clash/' },
  { label: '节点实测', href: '/nodes/' },
  { label: '梯子指南', href: '/tizi/' },
  { label: '免费白皮书', href: '/free/' },
  { label: '使用教程', href: '/tutorial/' },
  { label: '42家品牌库', href: '/brands/' },
]
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__pillars" aria-label="核心专题索引">
      <span class="mono-label site-footer__pillars-label">专题索引</span>
      <nav class="site-footer__pillars-nav">
        {pillars.map((item) => (
          <a href={item.href} class="site-footer__pillar-link">{item.label}</a>
        ))}
      </nav>
    </div>

    <div class="site-footer__row">
      <div class="site-footer__brand">
        <a class="wordmark" href="/">
          <img class="wordmark__avatar" src="/avatar.webp" alt={site.name} width="22" height="22" />
          {site.name}
        </a>
        <span>{footer.tagline}</span>
      </div>
      {
        links.length > 0 && (
          <nav class="site-footer__links" aria-label={ui.footer.navAria}>
            {links.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            ))}
          </nav>
        )
      }
    </div>
    <p class="mono-label site-footer__meta">
      © {year} {site.name} · {ui.footer.builtWith} · 严谨实测 · 零虚构承诺
    </p>
  </div>
</footer>

<style>
  .site-footer__pillars {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-5);
    border-bottom: 1px dashed var(--line-1);
    font-size: 13px;
  }
  .site-footer__pillars-label {
    color: var(--amber-dim);
    letter-spacing: 0.08em;
  }
  .site-footer__pillars-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
  }
  .site-footer__pillar-link {
    color: var(--fg-2);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .site-footer__pillar-link:hover {
    color: var(--amber);
  }
</style>
