---
import { footer, site, ui } from '../data/site'

const year = new Date().getFullYear()

// Only the links that are set in site.links are shown.
const LINK_LABELS: Record<string, string> = {
  github: 'GitHub',
  telegram: 'Telegram',
  rss: 'RSS',
}
const links = (Object.keys(site.links) as (keyof typeof site.links)[])
  .filter((key) => site.links[key])
  .map((key) => ({ label: LINK_LABELS[key] ?? key, href: site.links[key] as string }))
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__row">
      <div class="site-footer__brand">
        <a class="wordmark" href="/">
          <img class="wordmark__avatar" src="/avatar.webp" alt={site.name} width="22" height="22" />
          {site.name}
        </a>
        <span>{footer.tagline}</span>
      </div>
      {
        links.length > 0 && (
          <nav class="site-footer__links" aria-label={ui.footer.navAria}>
            {links.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            ))}
          </nav>
        )
      }
    </div>
    <p class="mono-label site-footer__meta">
      © {year} {site.name} · {ui.footer.builtWith}
    </p>
  </div>
</footer>
