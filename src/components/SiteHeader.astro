---
import { nav, site, ui } from '../data/site'
import type { NavIcon } from '../data/types'

// Below 640px the text nav is hidden; external items with an icon stay visible.
const iconLinks = nav.filter((link) => link.external && link.icon)

const ICON_PATHS: Record<NavIcon, string> = {
  posts: 'M2.5 2h11v12h-11zM5 5.5h6M5 8h6M5 10.5h3.5',
  code: 'M6 11.5 3.5 8 6 4.5M10 4.5 12.5 8 10 11.5',
  link: 'M4.5 11.5l7-7M6 4.5h5.5V10',
  dashboard: 'M2 2h5v5H2zm7 0h5v5H9zm-7 7h5v5H2zm7 0h5v5H9z',
  apps: 'M2 4h12M2 8h12M2 12h12',
  book: 'M3 3.5A2.5 2.5 0 0 1 5.5 1h7.5v12.5H5.5A2.5 2.5 0 0 0 3 16V3.5z',
  shield: 'M8 1.5 2.5 4v4.5C2.5 12 8 15 8 15s5.5-3 5.5-6.5V4L8 1.5z',
  gift: 'M2 4h12v3H2zm2 3v7h8V7m-4 0v7M5.5 4a2 2 0 1 1 2-2c0 1.5-2 2-2 2zm5 0a2 2 0 1 0-2-2c0 1.5 2 2 2 2',
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="wordmark" href="/" aria-label={`${site.name} ${ui.header.homeAria}`}>
      <img class="wordmark__avatar" src="/avatar.webp" alt={site.name} width="24" height="24" />
      {site.name}
    </a>

    <nav class="site-nav" aria-label={ui.header.mainNavAria}>
      {
        nav.map((link) =>
          link.external ? (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
              <span class="arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          ) : (
            <a href={link.href}>{link.label}</a>
          ),
        )
      }
    </nav>

    {
      iconLinks.length > 0 && (
        <nav class="site-nav__icons" aria-label={ui.header.externalNavAria}>
          {iconLinks.map((link) => (
            <a
              class="icon-btn"
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.label}
            >
              <svg
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={ICON_PATHS[link.icon ?? 'link']} />
              </svg>
            </a>
          ))}
        </nav>
      )
    }
  </div>
</header>
