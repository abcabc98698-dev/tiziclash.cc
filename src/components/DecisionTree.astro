---

<div class="decision-section">
  <div class="section-head">
    <div class="section-head__title">
      <span class="mono-label is-accent">Quick Recommendation Matrix</span>
      <h2 class="t-h2">🎯 30 秒机场选型决策树</h2>
    </div>
    <span class="mono-label">按需匹配 · 拒绝多花冤枉钱</span>
  </div>

  <div class="decision-grid">
    {
      SCENARIOS.map((sc) => (
        <div class="decision-card grain">
          <div class="decision-card__head">
            <span class="mono-label is-accent">{sc.tag}</span>
            <h3 class="decision-card__title">{sc.title}</h3>
            <p class="decision-card__desc">{sc.desc}</p>
          </div>

          <div class="decision-recommends">
            <span class="mono-label recommend-label">实验室优选对齐方案:</span>
            <div class="recommend-list">
              {sc.recommends.map((rec) => (
                <a href={rec.link} class="recommend-item">
                  <div class="recommend-item__left">
                    <strong>{rec.name}</strong>
                    <span class="badge">{rec.badge}</span>
                  </div>
                  <span class="recommend-item__reason">{rec.reason}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .decision-section {
    margin-top: var(--space-8);
  }

  .decision-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  .decision-card {
    background: var(--bg-1);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .decision-card:hover {
    transform: translateY(-2px);
    border-color: rgba(232, 180, 88, 0.4);
  }

  .decision-card__title {
    font-size: 17px;
    font-weight: 600;
    color: var(--fg-1);
    margin: var(--space-2) 0;
  }

  .decision-card__desc {
    font-size: 13px;
    color: var(--fg-2);
    line-height: 1.5;
    margin: 0;
  }

  .decision-recommends {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line-1);
  }

  .recommend-label {
    font-size: 11px;
    margin-bottom: var(--space-2);
    display: block;
  }

  .recommend-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .recommend-item {
    background: var(--bg-2);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .recommend-item:hover {
    background: var(--bg-3);
    border-color: var(--accent);
  }

  .recommend-item__left {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .recommend-item__left strong {
    font-size: 14px;
    color: var(--fg-1);
  }

  .recommend-item__reason {
    font-size: 12px;
    color: var(--fg-3);
  }
</style>
