---
import { getTopBrands } from '../data/brands'

const topBrands = getTopBrands(10)
---

<div class="ranking-section" id="rankings">
  <div class="section-head">
    <div class="section-head__title">
      <span class="mono-label is-accent">2026 Recommended Tier List</span>
      <h2 class="t-h2">🏆 2026 梯子机场综合评测 TOP 10 榜单</h2>
    </div>
    <span class="mono-label">数据来源: 实验室晚高峰实测 · 持续常态化探针监控</span>
  </div>

  <div class="ranking-table-wrapper grain">
    <!-- 桌面端紧凑基准大表 (≥ 769px) -->
    <div class="table-responsive desktop-only">
      <table class="ranking-table">
        <thead>
          <tr>
            <th>排名</th>
            <th>品牌名称</th>
            <th>链路专线 / 协议</th>
            <th>入门月费</th>
            <th>优惠码</th>
            <th>客户端模式</th>
            <th>评测得分</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          {
            topBrands.map((brand) => {
              const isFirst = brand.rank === 1
              return (
                <tr class={isFirst ? 'is-champion' : ''}>
                  <td>
                    <span
                      class={`rank-badge ${isFirst ? 'is-gold' : brand.rank && brand.rank <= 3 ? 'is-silver' : ''}`}
                    >
                      {isFirst ? '★ TOP 1' : `#${brand.rank}`}
                    </span>
                  </td>
                  <td>
                    <div class="brand-cell">
                      <a href={`/brands/${brand.slug}/`} class="brand-link">
                        <strong>{brand.name}</strong>
                      </a>
                      {isFirst && <span class="badge badge--amber">首推旗舰</span>}
                      {brand.slug === 'guangsu' && <span class="badge badge--dark">147永久套餐</span>}
                    </div>
                  </td>
                  <td>
                    <span class="mono-label is-accent">{brand.lineType}</span>
                    <div class="mono-label protocol-tags">{brand.protocols.slice(0, 3).join(' / ')}</div>
                  </td>
                  <td>
                    <span class="price-val">¥{brand.entryPriceMonth}</span>
                    <span class="price-sub">/月起</span>
                  </td>
                  <td>
                    {brand.promoCode ? (
                      <code class="promo-code" title="结账时输入享受优惠">
                        {brand.promoCode}
                      </code>
                    ) : (
                      <span class="mono-label">—</span>
                    )}
                  </td>
                  <td>
                    <span class="client-type-text">{brand.clientType}</span>
                  </td>
                  <td>
                    <div class="rating-box">
                      <span class="rating-score">
                        {isFirst ? '9.9' : (9.9 - (brand.rank || 0) * 0.12).toFixed(1)}
                      </span>
                      <span class="rating-desc">{isFirst ? '极力推荐' : '稳健精选'}</span>
                    </div>
                  </td>
                  <td>
                    <div class="action-buttons">
                      <a
                        href={brand.affiliateUrl}
                        target="_blank"
                        rel="nofollow sponsored noopener"
                        class={`btn btn--sm ${isFirst ? 'btn--primary' : ''}`}
                      >
                        官网直达
                        <span class="arrow" aria-hidden="true">↗</span>
                      </a>
                      <a href={`/brands/${brand.slug}/`} class="btn-text">
                        评测
                      </a>
                    </div>
                  </td>
                </tr>
              )
            })
          }
        </tbody>
      </table>
    </div>

    <!-- 移动端响应式卡片流 (≤ 768px) -->
    <div class="ranking-mobile-cards mobile-only">
      {
        topBrands.map((brand) => {
          const isFirst = brand.rank === 1
          return (
            <div class={`rank-card ${isFirst ? 'is-champion-card' : ''}`}>
              <div class="rank-card__header">
                <div class="rank-card__title">
                  <span
                    class={`rank-badge ${isFirst ? 'is-gold' : brand.rank && brand.rank <= 3 ? 'is-silver' : ''}`}
                  >
                    {isFirst ? '★ TOP 1' : `#${brand.rank}`}
                  </span>
                  <a href={`/brands/${brand.slug}/`} class="rank-card__name">
                    {brand.name}
                  </a>
                  {isFirst && <span class="badge badge--amber">首推旗舰</span>}
                </div>
                <div class="rating-box">
                  <span class="rating-score">
                    {isFirst ? '9.9' : (9.9 - (brand.rank || 0) * 0.12).toFixed(1)}
                  </span>
                </div>
              </div>

              <div class="rank-card__meta">
                <span class="mono-label is-accent">{brand.lineType}</span>
                <span class="mono-label separator">·</span>
                <span class="mono-label">{brand.clientType}</span>
              </div>

              <div class="rank-card__specs">
                <div class="spec-col">
                  <span class="mono-label">入门月费</span>
                  <div class="price-box">
                    <span class="price-val">¥{brand.entryPriceMonth}</span>
                    <span class="price-sub">/月起</span>
                  </div>
                </div>
                {brand.promoCode && (
                  <div class="spec-col">
                    <span class="mono-label">优惠码</span>
                    <code class="promo-code">{brand.promoCode}</code>
                  </div>
                )}
              </div>

              <div class="rank-card__actions">
                <a
                  href={brand.affiliateUrl}
                  target="_blank"
                  rel="nofollow sponsored noopener"
                  class={`btn btn--sm ${isFirst ? 'btn--primary' : ''}`}
                >
                  直达官网
                  <span class="arrow" aria-hidden="true">↗</span>
                </a>
                <a href={`/brands/${brand.slug}/`} class="btn btn--sm btn--subtle">
                  深度评测
                </a>
              </div>
            </div>
          )
        })
      }
    </div>

    <div class="ranking-table-notice mono-label">
      <span>* 声明：所有外部链接均为合规推广链接，通过链接注册可能为本实验室带来服务器维护佣金，绝不影响用户实际支付价格。</span>
      <span>数据核实周期: 2026.10 晚高峰常态化实测</span>
    </div>
  </div>
</div>

<style>
  .ranking-section {
    margin-top: var(--space-8);
  }

  .ranking-table-wrapper {
    background: var(--bg-1);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    margin-top: var(--space-4);
  }

  /* 显隐切换 */
  .desktop-only {
    display: block;
  }
  .mobile-only {
    display: none;
  }

  .table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .ranking-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 860px;
  }

  .ranking-table th {
    padding: 12px 14px;
    font-size: 13px;
    font-weight: 500;
    color: var(--fg-3);
    border-bottom: 1px solid var(--line-1);
    font-family: var(--font-mono);
  }

  .ranking-table td {
    padding: 14px 14px;
    border-bottom: 1px solid var(--line-1);
    vertical-align: middle;
  }

  .ranking-table tr:last-child td {
    border-bottom: none;
  }

  .ranking-table tr.is-champion {
    background: rgba(232, 180, 88, 0.05);
  }

  .rank-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    background: var(--bg-3);
    color: var(--fg-2);
    white-space: nowrap;
  }

  .rank-badge.is-gold {
    background: var(--accent);
    color: #0b0b0c;
    box-shadow: 0 0 10px var(--accent-glow);
    font-weight: 700;
  }

  .rank-badge.is-silver {
    background: rgba(255, 255, 255, 0.15);
    color: var(--fg-1);
  }

  .brand-cell {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .brand-link {
    color: var(--fg-1);
    font-size: 15px;
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .brand-link:hover {
    color: var(--accent);
  }

  .price-val {
    font-size: 16px;
    font-weight: 600;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .price-sub {
    font-size: 12px;
    color: var(--fg-3);
  }

  .promo-code {
    background: var(--bg-2);
    border: 1px dashed var(--accent);
    color: var(--accent);
    padding: 3px 6px;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 600;
    font-family: var(--font-mono);
  }

  .protocol-tags {
    font-size: 11px;
    color: var(--fg-3);
    margin-top: 2px;
  }

  .client-type-text {
    font-size: 13px;
    color: var(--fg-2);
  }

  .rating-box {
    display: flex;
    flex-direction: column;
  }

  .rating-score {
    font-family: var(--font-mono);
    font-weight: 700;
    color: #10b981;
    font-size: 14px;
  }

  .rating-desc {
    font-size: 11px;
    color: var(--fg-3);
  }

  .action-buttons {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .btn--sm {
    padding: 6px 12px;
    font-size: 13px;
  }

  .btn-text {
    font-size: 12px;
    color: var(--fg-3);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .btn-text:hover {
    color: var(--fg-1);
  }

  /* 移动端卡片布局 */
  .ranking-mobile-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .rank-card {
    background: var(--bg-2);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-sm);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .rank-card.is-champion-card {
    border-color: var(--accent);
    background: linear-gradient(135deg, rgba(232, 180, 88, 0.08) 0%, var(--bg-2) 100%);
  }

  .rank-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .rank-card__title {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .rank-card__name {
    font-size: 16px;
    font-weight: 700;
    color: var(--fg-1);
  }

  .rank-card__meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
  }

  .rank-card__meta .separator {
    color: var(--fg-4);
  }

  .rank-card__specs {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--bg-1);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
  }

  .spec-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .spec-col .mono-label {
    font-size: 10px;
    color: var(--fg-3);
  }

  .rank-card__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
  }

  .rank-card__actions .btn {
    text-align: center;
    justify-content: center;
  }

  .ranking-table-notice {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line-1);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: 12px;
    color: var(--fg-3);
  }

  @media (max-width: 768px) {
    .desktop-only {
      display: none;
    }
    .mobile-only {
      display: flex;
    }
  }
</style>
