---
import { hero } from '../data/site'
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__lead">
    <div class="hero__profile">
      <div class="hero__avatar-box">
        <img
          src="/avatar.webp"
          alt="梯子Clash 实验室"
          class="hero__avatar"
          width="76"
          height="76"
          loading="eager"
        />
        <div class="hero__avatar-status" title="网络探针持续在线"></div>
      </div>
      <div class="hero__profile-text">
        <span class="mono-label is-accent">{hero.eyebrow}</span>
        {hero.handle && <span class="mono hero__handle">{hero.handle}</span>}
      </div>
    </div>

    <div class="hero__title">
      <h1 class="t-display" id="hero-title">{hero.name}</h1>
    </div>
    <div class="hero__text stack">
      {hero.lead.map((paragraph) => <p class="t-lead">{paragraph}</p>)}
    </div>
    <div class="hero__actions">
      <a class="btn btn--primary" href={hero.actions.primary.href}>
        {hero.actions.primary.label}
        <span class="arrow" aria-hidden="true">↓</span>
      </a>
      {
        hero.actions.secondary && (
          <a class="btn" href={hero.actions.secondary.href}>
            {hero.actions.secondary.label}
          </a>
        )
      }
    </div>
  </div>

  <dl class="rows hero__facts">
    {
      hero.facts.map((fact) => (
        <div>
          <dt class="mono-label">{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
