---
import type { Brand } from '../data/types'

interface Props {
  brand: Brand
}

const { brand } = Astro.props
---

<article class={`brand-card grain ${brand.isFeatured ? 'is-featured' : ''}`}>
  <div class="brand-card__header">
    <div class="brand-card__title-row">
      <h3 class="brand-card__name">
        {brand.hasDetailPage ? (
          <a href={`/brands/${brand.slug}/`}>{brand.name}</a>
        ) : (
          brand.name
        )}
      </h3>
      {brand.isFeatured && <span class="badge badge--amber">实验室首推</span>}
      {brand.rank && <span class="rank-badge">#{brand.rank}</span>}
    </div>
    <span class="mono-label brand-card__meta">
      {brand.foundedYear}年运营 · {brand.lineType}
    </span>
  </div>

  <p class="brand-card__intro clamp-2">{brand.intro}</p>

  <div class="brand-card__pricing">
    <div class="price-block">
      <span class="mono-label">入门方案</span>
      <div class="price-num">
        <span class="currency">¥</span>
        <strong class="val">{brand.entryPriceMonth}</strong>
        <span class="period">/月起 ({brand.entryTrafficMonth})</span>
      </div>
    </div>

    {brand.promoCode && (
      <div class="code-block">
        <span class="mono-label">优惠码</span>
        <code class="promo-pill">{brand.promoCode}</code>
      </div>
    )}
  </div>

  <div class="brand-card__tags pills">
    {brand.protocols.slice(0, 3).map((p) => <span class="pill">{p}</span>)}
    <span class="pill pill--line">{brand.clientType}</span>
  </div>

  <div class="brand-card__actions">
    {
      brand.affiliateUrl ? (
        <a
          href={brand.affiliateUrl}
          target="_blank"
          rel="nofollow sponsored noopener"
          class={`btn ${brand.isFeatured ? 'btn--primary' : ''}`}
        >
          官网注册直达
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ) : (
        <span class="btn btn--disabled" title="历史品牌，未公开独立注册入口，仅供参数横向比对">
          未公开独立入口
        </span>
      )
    }
    {
      brand.hasDetailPage && (
        <a href={`/brands/${brand.slug}/`} class="btn btn--subtle">
          深度评测
        </a>
      )
    }
  </div>
</article>

<style>
  .brand-card {
    background: var(--bg-1);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .brand-card:hover {
    transform: translateY(-2px);
    border-color: rgba(232, 180, 88, 0.4);
  }

  .brand-card.is-featured {
    border-color: var(--accent);
    box-shadow: 0 0 20px rgba(232, 180, 88, 0.08);
  }

  .brand-card__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .brand-card__name {
    font-size: 19px;
    font-weight: 600;
    margin: 0;
    color: var(--fg-1);
  }

  .brand-card__name a {
    color: inherit;
    text-decoration: none;
  }
  .brand-card__name a:hover {
    color: var(--accent);
  }

  .brand-card__meta {
    display: block;
    margin-top: 4px;
    color: var(--fg-3);
    font-size: 12px;
  }

  .brand-card__intro {
    font-size: 13px;
    color: var(--fg-2);
    line-height: 1.5;
    margin: var(--space-3) 0;
  }

  .brand-card__pricing {
    background: var(--bg-2);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .price-block .mono-label,
  .code-block .mono-label {
    font-size: 10px;
    display: block;
    color: var(--fg-3);
  }

  .price-num {
    display: flex;
    align-items: baseline;
    gap: 2px;
  }

  .currency {
    font-size: 13px;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .price-num .val {
    font-size: 18px;
    font-weight: 700;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .period {
    font-size: 11px;
    color: var(--fg-3);
  }

  .promo-pill {
    background: var(--bg-3);
    border: 1px dashed var(--accent);
    color: var(--accent);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
  }

  .brand-card__tags {
    margin-bottom: var(--space-4);
  }

  .pill--line {
    background: var(--bg-3);
    color: var(--fg-2);
  }

  .brand-card__actions {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-2);
    align-items: center;
  }

  .btn--subtle {
    background: transparent;
    border: 1px solid var(--line-2);
    color: var(--fg-2);
    padding: 8px 12px;
    font-size: 13px;
  }
  .btn--subtle:hover {
    color: var(--fg-1);
    border-color: var(--fg-1);
  }

  .btn--disabled {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-2);
    border: 1px dashed var(--line-1);
    color: var(--fg-4);
    cursor: not-allowed;
    font-size: 13px;
    padding: 8px 14px;
    border-radius: var(--radius-sm);
  }
</style>
